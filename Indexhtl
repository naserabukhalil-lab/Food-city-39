        <span id="toastMsg">Уведомление</span>
    </div>

    <!-- Скрипты и логика -->
    <script>
        // Исходные данные товаров
        let products = [
            {
                id: 1,
                name: 'Египетский гранат',
                variety: 'Wonderful (Вандерфул) / Отборный',
                caliber: '8 / 10 / 12 (Крупный)',
                boxWeight: '4.5 кг',
                boxesPerPallet: 160,
                netWeightKg: 720,
                pricePerPallet: 145000,
                status: 'in_stock',
                description: 'Ярко-красные зерна, сочные, плотная кожура отлично переносит транспортировку в регионы.'
            },
            {
                id: 2,
                name: 'Египетские мандарины',
                variety: 'Клементины / Сладкий фреш',
                caliber: '1 - 2 - 3 (Средний и крупный)',
                boxWeight: '8.0 кг',
                boxesPerPallet: 100,
                netWeightKg: 800,
                pricePerPallet: 110000,
                status: 'in_stock',
                description: 'Легко чистятся, сладкие, высокий спрос в зимний сезон и перед праздниками.'
            },
            {
                id: 3,
                name: 'Египетские лимоны',
                variety: 'Eureka (Юрика) / Адалия',
                caliber: '80 / 100 / 113',
                boxWeight: '15.0 кг',
                boxesPerPallet: 80,
                netWeightKg: 1200,
                pricePerPallet: 95000,
                status: 'in_stock',
                description: 'Плотная шкура, ярко-желтый цвет, долгий срок хранения на складе и в дороге.'
            },
            {
                id: 4,
                name: 'Египетские грейпфруты',
                variety: 'Star Ruby (Стар Руби красный)',
                caliber: '36 / 40 / 48',
                boxWeight: '15.0 кг',
                boxesPerPallet: 80,
                netWeightKg: 1200,
                pricePerPallet: 105000,
                status: 'expected',
                description: 'Сочная красная мякоть, сладкие. Ожидается новый контейнер на склад 1/39.'
            },
            {
                id: 5,
                name: 'Египетские апельсины',
                variety: 'Navel (Пупочный) / Valencia',
                caliber: '48 / 56 / 64 / 72',
                boxWeight: '15.0 кг',
                boxesPerPallet: 80,
                netWeightKg: 1200,
                pricePerPallet: 88000,
                status: 'in_stock',
                description: 'Стабильное высокое качество, калиброванные фрукты для сетей и рынков.'
            }
        ];

        // Рендер каталога
        function renderProducts() {
            const grid = document.getElementById('productGrid');
            grid.innerHTML = '';

            products.forEach(p => {
                let statusBadge = '';
                if(p.status === 'in_stock') {
                    statusBadge = `<span class="bg-emerald-100 text-emerald-800 text-[11px] font-bold px-2.5 py-1 rounded-full">В наличии на складе 1/39</span>`;
                } else if(p.status === 'expected') {
                    statusBadge = `<span class="bg-amber-100 text-amber-800 text-[11px] font-bold px-2.5 py-1 rounded-full">Ожидается контейнер</span>`;
                } else {
                    statusBadge = `<span class="bg-slate-200 text-slate-700 text-[11px] font-bold px-2.5 py-1 rounded-full">Забронировано</span>`;
                }

                const card = `
                    <div class="bg-white rounded-2xl p-5 border border-slate-200 shadow-sm hover:shadow-md transition flex flex-col justify-between">
                        <div>
                            <div class="flex justify-between items-start mb-3 gap-2">
                                <h3 class="font-extrabold text-slate-900 text-lg">${p.name}</h3>
                                ${statusBadge}
                            </div>
                            <div class="text-xs text-brand-green font-bold mb-2">Сорт: ${p.variety}</div>
                            <p class="text-xs text-slate-600 mb-4 leading-relaxed">${p.description}</p>

                            <div class="bg-slate-50 p-3 rounded-xl space-y-1.5 text-xs text-slate-700 mb-4 border border-slate-100 font-semibold">
                                <div class="flex justify-between">
                                    <span class="text-slate-500">Калибр:</span>
                                    <span class="font-bold text-slate-900">${p.caliber}</span>
                                </div>
                                <div class="flex justify-between">
                                    <span class="text-slate-500">Ящиков на паллете:</span>
                                    <span class="font-bold text-slate-900">${p.boxesPerPallet} шт (${p.boxWeight})</span>
                                </div>
                                <div class="flex justify-between">
                                    <span class="text-slate-500">Чистый вес паллеты:</span>
                                    <span class="font-bold text-slate-900">~${p.netWeightKg} кг</span>
                                </div>
                            </div>
                        </div>

                        <div>
                            <div class="pt-3 border-t border-slate-100 flex justify-between items-end mb-4">
                                <div>
                                    <div class="text-[10px] text-slate-400 uppercase font-bold">Цена за паллету</div>
                                    <div class="text-xl font-black text-slate-900">${p.pricePerPallet.toLocaleString()} ₽</div>
                                </div>
                                <div class="text-right text-[11px] text-slate-500 font-bold">
                                    ~${Math.round(p.pricePerPallet / p.netWeightKg)} ₽/кг
                                </div>
                            </div>

                            <button onclick="quickBookModal('${p.name}')" class="w-full bg-brand-green hover:bg-brand-darkgreen text-white font-bold py-2.5 rounded-xl text-xs transition">
                                Забронировать паллету
                            </button>
                        </div>
                    </div>
                `;
                grid.innerHTML += card;
            });

            populateCalcSelect();
        }

        function populateCalcSelect() {
            const select = document.getElementById('calcProduct');
            select.innerHTML = '';
            products.forEach(p => {
                select.innerHTML += `<option value="${p.id}">${p.name} — ${p.pricePerPallet.toLocaleString()} ₽ / паллета</option>`;
            });
            calculateOrder();
        }

        function calculateOrder() {
            const pId = parseInt(document.getElementById('calcProduct').value);
            const qty = parseInt(document.getElementById('calcQty').value) || 1;
            const product = products.find(p => p.id === pId);

            if(!product) return;

            const totalBoxes = product.boxesPerPallet * qty;
            const totalWeight = product.netWeightKg * qty;
            const totalPrice = product.pricePerPallet * qty;

            document.getElementById('calcTotalBoxes').innerText = `${totalBoxes.toLocaleString()} шт`;
            document.getElementById('calcTotalWeight').innerText = totalWeight >= 1000 ? `${(totalWeight/1000).toFixed(2)} т` : `${totalWeight} кг`;
            document.getElementById('calcPricePerPallet').innerText = `${product.pricePerPallet.toLocaleString()} ₽`;
            document.getElementById('calcTotalPrice').innerText = `${totalPrice.toLocaleString()} ₽`;
        }

        function changeCalcQty(delta) {
            const input = document.getElementById('calcQty');
            let val = parseInt(input.value) || 1;
            val += delta;
            if(val < 1) val = 1;
            input.value = val;
            calculateOrder();
        }

        function handleQuickOrder(e) {
            e.preventDefault();
            showToast('Заявка отправлена! Менеджер Склада 1/39 свяжется с вами в течение 5 минут.');
            e.target.reset();
        }

        function quickBookModal(productName) {
            showToast(`Вы выбрали: ${productName}. Оформите заказ ниже или позвоните на +7 (916) 102-95-01`);
            window.location.href = '#contacts';
        }

        function showToast(msg) {
            const toast = document.getElementById('toast');
            document.getElementById('toastMsg').innerText = msg;
            toast.classList.remove('translate-y-20', 'opacity-0', 'pointer-events-none');
            setTimeout(() => {
                toast.classList.add('translate-y-20', 'opacity-0', 'pointer-events-none');
            }, 3500);
        }

        // Логика модального окна админки
        function toggleAdminModal() {
            const modal = document.getElementById('adminModal');
            modal.classList.toggle('hidden');
            if(!modal.classList.contains('hidden')) {
                renderAdminList();
            }
        }

        function renderAdminList() {
            const list = document.getElementById('adminProductList');
            list.innerHTML = '';

            products.forEach(p => {
                list.innerHTML += `
                    <div class="p-4 bg-slate-50 rounded-xl border border-slate-200 grid sm:grid-cols-12 gap-3 items-center text-xs">
                        <div class="sm:col-span-3 font-bold text-slate-900 text-sm">${p.name}</div>
                        
                        <div class="sm:col-span-3">
                            <label class="block text-[10px] font-bold text-slate-500 mb-1">Цена за паллету (₽)</label>
                            <input type="number" id="adminPrice_${p.id}" value="${p.pricePerPallet}" class="w-full p-2 bg-white border border-slate-300 rounded font-bold text-slate-800">
                        </div>

                        <div class="sm:col-span-3">
                            <label class="block text-[10px] font-bold text-slate-500 mb-1">Ящиков на паллете</label>
                            <input type="number" id="adminBoxes_${p.id}" value="${p.boxesPerPallet}" class="w-full p-2 bg-white border border-slate-300 rounded font-bold text-slate-800">
                        </div>

                        <div class="sm:col-span-3">
                            <label class="block text-[10px] font-bold text-slate-500 mb-1">Статус наличия</label>
                            <select id="adminStatus_${p.id}" class="w-full p-2 bg-white border border-slate-300 rounded font-bold">
                                <option value="in_stock" ${p.status === 'in_stock' ? 'selected' : ''}>В наличии на складе</option>
                                <option value="expected" ${p.status === 'expected' ? 'selected' : ''}>Ожидается контейнер</option>
                                <option value="out_of_stock" ${p.status === 'out_of_stock' ? 'selected' : ''}>Забронировано</option>
                            </select>
                        </div>
                    </div>
                `;
            });
        }

        function saveAdminChanges() {
            products.forEach(p => {
                const newPrice = parseInt(document.getElementById(`adminPrice_${p.id}`).value);
                const newBoxes = parseInt(document.getElementById(`adminBoxes_${p.id}`).value);
                const newStatus = document.getElementById(`adminStatus_${p.id}`).value;

                if(!isNaN(newPrice)) p.pricePerPallet = newPrice;
                if(!isNaN(newBoxes)) p.boxesPerPallet = newBoxes;
                if(newStatus) p.status = newStatus;
            });

            renderProducts();
            toggleAdminModal();
            showToast('Цены и наличие успешно обновлены!');
        }

        window.onload = function() {
            renderProducts();
        };
    </script>
